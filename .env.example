# lfmigrate configuration. Copy to .env and chmod 600 (the loader refuses group/world-readable files).
# Required settings are active; the rest are commented at their default. No CLI flag takes a secret.
#
# Full reference:  python -m lfmigrate config --list
# This file:       python -m lfmigrate config --example > .env.example

# ── Source: Langfuse ──────────────────────────────────────────────
LANGFUSE_HOST=https://cloud.langfuse.com # REQUIRED — Langfuse base URL
LANGFUSE_PUBLIC_KEY=                # REQUIRED — secret — Langfuse public key (pk-...)
LANGFUSE_SECRET_KEY=                # REQUIRED — secret — Langfuse secret key (sk-...)
# LANGFUSE_SOURCE_MODE=api          # Where to read history from
# LANGFUSE_API_GENERATION=          # Pin the API generation (v4 | v3) instead of probing…
# LANGFUSE_TIMEOUT_SECONDS=60       # HTTP timeout for Langfuse requests
# LANGFUSE_PAGE_LIMIT=1000          # Records per page when reading observations
# LANGFUSE_SCORE_PAGE_LIMIT=100     # Records per page when reading scores
# LANGFUSE_OBSERVATION_FIELDS=      # Override the observation field groups requested
# LANGFUSE_SCORE_FIELDS=            # Override the score field groups
# LANGFUSE_METRICS_CHUNK_DAYS=60    # Days per metrics request when discovering the…
# LANGFUSE_EXPAND_METADATA_KEYS=    # Comma-separated metadata keys to return untruncated

# ── Destination: Arize AX ─────────────────────────────────────────
ARIZE_API_KEY=                      # REQUIRED — secret — Arize AX API key
ARIZE_SPACE_ID=                     # REQUIRED — Arize AX space id
# ARIZE_PROJECT_NAME=               # Destination project, used verbatim with no timestamp
# ARIZE_PROJECT_PREFIX=langfuse-backfill # Prefix for the auto-generated name
# ARIZE_AI_INTEGRATION_ID=          # AX AI integration that migrated LLM judges run on
# ARIZE_REGION=us                   # Region the space is homed in: us | us-central-1a |…
# ARIZE_API_HOST=                   # Override the REST host
# ARIZE_OTLP_HOST=                  # Override the OTLP host
# ARIZE_FLIGHT_HOST=                # Override the Arrow Flight host
# ARIZE_FLIGHT_PORT=443             # Arrow Flight port

# ── Migration behaviour ───────────────────────────────────────────
# LFMIGRATE_EVAL_INTEGRATIONS=      # Per-provider integrations, e.g.…
# LFMIGRATE_EVAL_DEFAULT_MODEL=     # Model for judges that use the Langfuse project…
# LFMIGRATE_EVAL_EXPORT_DIR=out/code-evaluators # Where code evaluators are written for manual porting
# LFMIGRATE_CREATE_EVAL_TASKS=false # Schedule evaluation rules as AX tasks
# LFMIGRATE_INGEST_PATH=auto        # auto (default; arrow when history is older than 31…
# LFMIGRATE_OTLP_SHARDS=8           # Concurrent OTLP exporters; the rate is flat from 4…
# LFMIGRATE_BATCH_SIZE=10000        # Spans per upload batch
# LFMIGRATE_BATCH_MAX_MB=32         # Byte budget per batch; splits a batch of unusually…
# LFMIGRATE_VALIDATE_UPLOAD=true    # SDK-side dataframe validation
# LFMIGRATE_MAX_PAST_YEARS=2        # Arize retention window in years
# LFMIGRATE_VERIFY_TIMEOUT_SECONDS=900 # How long to poll readback before declaring a day…
# LFMIGRATE_VERIFY_INTERVAL_SECONDS=30 # Poll interval while waiting for indexing
# LFMIGRATE_SHARD_ROOT=out/manifests # Where shards and manifests are written
# LFMIGRATE_VERIFY_MODE=end         # Readback verification: end (one check, default) |…
# LFMIGRATE_QUIET_SDK_WARNINGS=true # Hide the SDK's per-endpoint [BETA] warnings
